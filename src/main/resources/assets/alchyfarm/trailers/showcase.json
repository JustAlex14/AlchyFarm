  "texts": [
    {
      "at": 40,
      "ticks": 110,
      "text": "AlchyFarm",
      "style": "title",
      "color": "#E8C66A"
    },
    {
      "at": 190,
      "ticks": 110,
      "text": "They sent me to a dying land, where I would not be seen.",
      "style": "caption"
    },
    {
      "at": 455,
      "ticks": 105,
      "text": "A hut stood here already. Its owner never came back.",
      "style": "caption"
    },
    {
      "at": 615,
      "ticks": 115,
      "text": "His books were still open. Whatever he did, the land had stopped dying.",
      "style": "caption"
    },
    {
      "at": 770,
      "ticks": 120,
      "text": "I built a field for myself. By morning, someone had taken my place.",
      "style": "caption"
    },
    {
      "at": 1110,
      "ticks": 110,
      "text": "I never asked them to stay. Nobody asked me either.",
      "style": "caption"
    },
    {
      "at": 1450,
      "ticks": 110,
      "text": "The hands do not sleep. I keep the accounts.",
      "style": "caption"
    },
    {
      "at": 1790,
      "ticks": 110,
      "text": "My family wrote once. I cut their crest from my seal.",
      "style": "caption"
    },
    {
      "at": 1960,
      "ticks": 110,
      "text": "I asked for stone. They bring back more than I wrote down.",
      "style": "caption"
    },
    {
      "at": 2450,
      "ticks": 120,
      "text": "AlchyFarm",
      "style": "title",
      "color": "#E8C66A"
    },
    {
      "at": 2475,
      "ticks": 95,
      "text": "The land can heal now.",
      "style": "subtitle"
    }
  ],
